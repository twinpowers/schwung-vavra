{
    "id": "vavra",
    "name": "Vavra",
    "abbrev": "MQ",
    "version": "0.0.1",
    "description": "Waldorf microQ emulator (Gearmulator)",
    "author": "dsp56300/gearmulator (port: charlesvestal)",
    "dsp": "dsp.so",
    "api_version": 2,
    "assets": {
        "path": "roms",
        "label": "ROMs",
        "extensions": [".bin", ".BIN", ".mid"],
        "description": "Requires a microQ OS 2.23 firmware image: one 512 KB .bin, or a 300-400 KB .mid OS update.",
        "hint": "OS 2.23 EPROM dumps in either byte order are accepted, with .bin or .BIN filenames.",
        "files": [
            {
                "filename": "microq223.bin",
                "label": "microQ OS 2.23 firmware",
                "size": 524288,
                "required": true
            }
        ]
    },
    "capabilities": {
        "audio_out": true,
        "audio_in": false,
        "midi_in": true,
        "midi_out": false,
        "default_forward_channel": 1,
        "chainable": true,
        "forks_processes": true,
        "component_type": "sound_generator"
    },
    "chain_params": [
        {"key": "dsp_clock", "name": "DSP Clock", "short_name": "Clock", "type": "int", "min": 25, "max": 100, "default": 75, "unit": "%"},
        {"key": "gain", "name": "Gain", "type": "int", "min": 0, "max": 100, "default": 70},
        {"key": "buffer_ms", "name": "Buffer", "short_name": "Buf", "type": "int", "min": 11, "max": 139, "default": 17, "unit": "ms"}
    ]
}
